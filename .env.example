# Copy to .env and fill in. Never commit the real .env file.

# --- Database ---------------------------------------------------------------
# SQLite (default, ships with sample data):
DATABASE_URL=sqlite:///data/sample.db
# PostgreSQL example (needs psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/analytics

# --- LLM --------------------------------------------------------------------
# auto   = OpenAI if OPENAI_API_KEY is set, otherwise the offline MockLLM
# openai = always OpenAI
# mock   = deterministic offline model (hallucinates `created_at` on purpose so
#          you can watch the self-correction loop work)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Agent ------------------------------------------------------------------
MAX_RETRIES=3
MAX_RESULT_ROWS=1000

# --- Guardrails -------------------------------------------------------------
# true = run the NeMo Guardrails input rail first (falls back to the built-in
# scanner if NeMo cannot start). The built-in scanner always runs as well.
USE_NEMO_GUARDRAILS=true
